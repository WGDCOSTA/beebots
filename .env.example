# beebots settings. Most people need NONE of this: the Setup page asks for your keys when you first open the site.
# Copy to .env (next to docker-compose.yml) only if you want to change something. NEVER commit .env.

# ---- Mode -------------------------------------------------------------------
# dry  = PAPER TRADING (the default): real market prices, simulated money, no exchange account needed
# demo = OKX demo trading with per-bee DEMO keys, fake money on OKX's side
# live = REAL MONEY. Needs DRY_RUN=false, MODE=live, per-bee LIVE keys AND LIVE_ACK below. Not financial advice.
MODE=dry
# Safety latch. true (the default, also when unset) forces paper trading whatever MODE says.
DRY_RUN=true
# Only for MODE=live: must be exactly I-ACCEPT-REAL-MONEY-RISK. You can lose everything you put in.
LIVE_ACK=

# ---- Setup ------------------------------------------------------------------
# The Setup page stays open this many minutes after the engine starts. First come, first served: once saved it closes
# for good. If nobody finishes in time, restart the engine container to open it again.
SETUP_WINDOW_MIN=120
# The owner password is picked on Setup and stored as a hash. Set this only if your Setup file has none (an install
# from before it existed, or keys set only here). At least 8 characters. Gates Join/Leave the Warren on the dashboard.
OWNER_PASSWORD=

# ---- Jev (TypeSafe AI) ------------------------------------------------------
# Optional here (Setup asks for it). Key from https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=2000
# Hard daily Jev spend cap in USD. When hit, every bunny holds and opens nothing until 00:00 UTC.
JEV_DAILY_USD_CAP=2
# Off by default. When enabled, active ledger experiments may make challenger calls with a separate daily budget.
# Challenger answers are recorded for comparison and never reach the order executor.
JEV_SHADOW_ENABLED=false
JEV_SHADOW_DAILY_USD_CAP=0.25
# Every Jev call also carries a shared block of technicals (RSI, MACD, Bollinger, ATR, 1h/24h moves, volume z, funding,
# open interest) beside each style's own columns. JEV_TECH=false sends only the style's columns.
# JEV_TECH=true
# How often each bunny asks Jev (ms). Degen's fast scalp loop does not call Jev for every trade (docs/COSTS.md).
TICK_MS=10000
# Full market refresh (candles, indicators, funding, OI): every 60 s
DATA_REFRESH_MS=60000

# ---- OpenAI (optional) --------------------------------------------------------
# Setup asks for this too (required there). Used only on the Setup page: design each bunny from a sentence, and paint it.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-nano
OPENAI_IMAGE_MODEL=gpt-image-2

# ---- OKX (EEA) --------------------------------------------------------------
# Market data comes from OKX's public EEA API. Demo/live keys must be EEA (my.okx.com) keys.
OKX_API_BASE=https://eea.okx.com

# Demo or live only: one OKX sub-account per bunny. Keys: Read + Trade ONLY. Never Withdraw, never Transfer.
# Live keys should be IP-bound to your server. Demo keys come from OKX's demo-trading screen.
BEE1_OKX_DEMO_API_KEY=
BEE1_OKX_DEMO_API_SECRET=
BEE1_OKX_DEMO_API_PASSPHRASE=
BEE2_OKX_DEMO_API_KEY=
BEE2_OKX_DEMO_API_SECRET=
BEE2_OKX_DEMO_API_PASSPHRASE=
BEE3_OKX_DEMO_API_KEY=
BEE3_OKX_DEMO_API_SECRET=
BEE3_OKX_DEMO_API_PASSPHRASE=
BEE4_OKX_DEMO_API_KEY=
BEE4_OKX_DEMO_API_SECRET=
BEE4_OKX_DEMO_API_PASSPHRASE=
BEE1_OKX_API_KEY=
BEE1_OKX_API_SECRET=
BEE1_OKX_API_PASSPHRASE=
BEE2_OKX_API_KEY=
BEE2_OKX_API_SECRET=
BEE2_OKX_API_PASSPHRASE=
BEE3_OKX_API_KEY=
BEE3_OKX_API_SECRET=
BEE3_OKX_API_PASSPHRASE=
BEE4_OKX_API_KEY=
BEE4_OKX_API_SECRET=
BEE4_OKX_API_PASSPHRASE=

# ---- Risk (every bunny) ---------------------------------------------------------
BEE_START_EQUITY_USD=333
MAX_LEVERAGE=2
# Per-bee daily loss stop, % of that bunny's equity at 00:00 UTC. Trip = flat until 00:00 UTC.
DAILY_LOSS_STOP_PCT=8
# If a bunny's equity falls below this % of its start, it retires for good.
BEE_RETIRE_AT_PCT=40
# Hard ceiling on any bunny's position size, whatever its balance says
MAX_NOTIONAL_USD_PER_BEE=700
# Paper only (MODE=dry): leverage cap above MAX_LEVERAGE, up to 5. 0 = off. Demo and live always keep MAX_LEVERAGE.
# Raise MAX_NOTIONAL_USD_PER_BEE with it, or that ceiling binds first.
PAPER_MAX_LEVERAGE=0
# Risk-based sizing: each open risks this % of equity if its stop is hit (size = risk / stop distance), capped by the
# leverage cap. 0 = the older rule (a share of the cap split across position slots).
RISK_PER_TRADE_PCT=0
# "Never flat for long" ceiling in minutes. Each style's own limit is min(its own, this).
MAX_FLAT_MINUTES=30
# First hours of live trading run at reduced size
LIVE_SIZE_MULTIPLIER=0.25
LIVE_RAMP_HOURS=2
MIN_24H_VOL_USD=1000000
# Master switch for the macro squad (extra bunnies on stocks, gold, oil; Admin -> Bunnies -> Market). Off: they watch and
# learn but never open. On: they open only in a trading hour the engine has verified (docs/MACRO_SQUAD.md).
# The crypto bunnies trade crypto only either way.
ALLOW_NON_CRYPTO=false
# Macro squad gates: stocks and gold trade far less than crypto on OKX
MACRO_MIN_24H_VOL_USD=200000
# The macro style's knobs (bees/macro.ts): trend pullbacks and range reversions, never forced in
MACRO_MAX_TRADES_PER_DAY=4
MACRO_FEE_BUDGET_USD_DAY=2
MACRO_SPREAD_GATE_BPS=15
MACRO_COOLDOWN_MINUTES=30
MACRO_STOP_ATR_MULT=2.5
# Leverage cap for macro positions (x equity, never above MAX_LEVERAGE), and the size factor under 2 h to the close
MACRO_MAX_LEVERAGE=1
MACRO_LATE_SESSION_SIZE=0.5
# Close macro positions before their session ends: all | weekend (closures of a day or more) | off, and how early
SESSION_FLATTEN=all
SESSION_FLATTEN_MIN=10
# No new macro position this close (minutes) to the end of a session
SESSION_NO_OPEN_MIN=30


# Dynamic profit-locking ratchet (bees/ratchet.ts), on top of each style's own stops; stops only ever tighten.
# RATCHET_LOCK: hard profit floor, gain%:keep (at +2.5% lock 50% of the best move, at +5% lock 65%).
# RATCHET_HUG: runner hug, gain%:ATR multiple (trail 1.2x ATR behind the peak from +2.5%, 0.8x from +5%, 0.6x from +8%).
# A gap or slippage can still fill past a stop: the floor is a stop level, not a guaranteed price.
RATCHET=true
RATCHET_LOCK=2.5:0.5,5:0.65
RATCHET_HUG=2.5:1.2,5:0.8,8:0.6
RATCHET_STYLES=bizzy,boozy,macro,skill

# ---- Degen scalper: maker orders on 1-minute rules ------------------------------------
# On by default for Degen. A scalp opens only when the strategy
# lab's latest report on REAL 1-minute data found an edge after costs (pnpm lab fetch --bar 1m; pnpm lab scalp).
# Jev sets a mandate (a coin, a bias, a lifetime, a trade budget); code then trades inside it with maker limit orders
# and hard stops, and a circuit breaker pauses the bunny after a run of losses. With real money the lab gate cannot be
# switched off. Paper fills for limit orders are optimistic: confirm on OKX demo before trusting any result.
SCALP=true
SCALP_REQUIRE_LAB=true
SCALP_LAB_MAX_AGE_DAYS=14
# * = any currently liquid crypto; each autonomous lab cycle evaluates the next rotating batch below.
# Passing coins stay pinned in later batches; failed batches are retried unchanged after a restart.
SCALP_COINS=*
SCALP_UNIVERSE_SIZE=20
SCALP_MAKER_FEE=0.0002
SCALP_TICK_MS=2000
SCALP_MAKER_WAIT_S=8
SCALP_EXIT_WAIT_S=3
SCALP_MANDATE_MIN=10
SCALP_MANDATE_MINUTES=30
SCALP_MANDATE_TRADES=20
SCALP_MAX_TRADES_PER_DAY=60
SCALP_FEE_BUDGET_USD_DAY=3
SCALP_SPREAD_GATE_BPS=1.5
SCALP_SIZE_FRAC=0.5
SCALP_MAX_LOSS_STREAK=4
SCALP_PAUSE_MIN=30
# ---- Per-style knobs ------------------------------------------------------------
# BIZZY_* = Breakout, BREEZY_* = Trend, BOOZY_* = Momentum. Every bunny on that style uses them.
# See strategies/*.md. COOLDOWN_MINUTES: wait after an order. STOP_ATR_MULT: stop distance in ATR(14).
BREEZY_MAX_TRADES_PER_DAY=3
BREEZY_FEE_BUDGET_USD_DAY=1.00
BREEZY_MIN_OPEN_PROB=0.70
BREEZY_MIN_SIZE_USD=10
BREEZY_SPREAD_GATE_BPS=5
BREEZY_COOLDOWN_MINUTES=240
BREEZY_STOP_ATR_MULT=2
BREEZY_MAX_FLAT_MINUTES=0

BIZZY_MAX_TRADES_PER_DAY=1
BIZZY_FEE_BUDGET_USD_DAY=1.00
BIZZY_SIZE_FRACTION=0.4
BIZZY_UNIVERSE_SIZE=8
BIZZY_MAX_FLAT_MINUTES=20
BIZZY_SPREAD_GATE_BPS=5
BIZZY_COOLDOWN_MINUTES=5
BIZZY_STOP_ATR_MULT=1.5
BIZZY_TIME_STOP_MINUTES=240

BOOZY_MAX_TRADES_PER_DAY=3
BOOZY_FEE_BUDGET_USD_DAY=3.00
BOOZY_SPREAD_GATE_BPS=15
BOOZY_CANDIDATES=5
BOOZY_COOLDOWN_MINUTES=2
BOOZY_STOP_ATR_MULT=2
BOOZY_MAX_FLAT_MINUTES=0

# ---- Server -------------------------------------------------------------------
# A domain pointed at this server gets automatic HTTPS. Blank = plain HTTP on the server's IP.
PUBLIC_DOMAIN=
LOG_LEVEL=info
# Alerts (optional): a Telegram bot, ntfy.sh topic or any webhook URL. Cap trips, Jev outages, restarts.
ALERT_WEBHOOK_URL=
# The Warren: the public paper-trading leaderboard. Nothing is sent unless you join (on Setup or from the dashboard).
HIVE_URL=https://beebots.tech
# "Update available" on the dashboard when a newer GitHub Release is out. It never installs anything by itself.
UPDATE_CHECK=true
# Dashboard links: the "Hosted on" chip and the code link.
HOST_LINK=https://mrc.fm/beebots
REPO_LINK=https://github.com/imikerussell/beebots

# ---- LLM brains, strategy lab and warren memory (docs/INTELLIGENCE.md) ------------
# Each main bunny thinks with its own LLM brain: it picks backtested skills, writes lessons and talks to the other bunnies
# through the warren memory (a knowledge graph). Brains never place orders: Jev still decides every tick and the risk layer
# still has the last word. A brain without a key falls back to a simple rules pick.
# ChatGPT uses OPENAI_API_KEY above. gpt-6-astra is a reasoning model: OPENAI_REASONING_EFFORT sets how hard it thinks
# (auto = each task's own effort; or off | low | medium | high | xhigh | max for every call; more effort, more tokens).
OPENAI_BRAIN_MODEL=gpt-6-astra
# OPENAI_REASONING_EFFORT=auto
# Brain prices for the admin console's cost estimates, USD per 1M tokens (input:output); a prefix covers a family:
# LLM_PRICES=gpt-6-astra=5:20,claude-opus-5=15:75
# Claude (Anthropic): https://console.anthropic.com
# Or leave it empty and sign in with an Anthropic Console account instead (docs/INTELLIGENCE.md):
#   docker compose exec engine ant --profile beebots auth login --no-browser
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium
# Kimi (Moonshot AI): https://platform.moonshot.ai  (MOONSHOT_API_KEY works too)
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.5
KIMI_BASE_URL=https://api.moonshot.ai/v1
# Alpaca (alpaca.markets) market data for the lab: US stocks, ETFs and crypto history. DATA ONLY: use paper keys.
# Also settable in Admin -> API keys. iex = free (one exchange); sip = every exchange, paid plan.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_FEED=iex
# Z.ai (GLM models): https://z.ai. International address below; China: https://open.bigmodel.cn/api/paas/v4
# Use the model id from your Z.ai console (glm-5.3 is the default here).
ZAI_API_KEY=
ZAI_MODEL=glm-5.3
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# Which brain each bunny thinks with: openai | claude | kimi | zai | the id of a custom brain added in Admin -> API keys
BEE1_BRAIN=openai
BEE2_BRAIN=claude
BEE3_BRAIN=kimi
BEE4_BRAIN=openai
# Where the lab keeps history, rankings, the playbook and the hive-mind graph
LAB_DIR=./data/lab
GRAPH_PATH=./data/lab/hive-mind.sqlite
# Folders of importable JSON skills (comma separated)
SKILLS_DIRS=./skills
# Show Jev each bunny's lab vote (its playbook skills on 1h bars) as a tiebreaker.
LAB_SIGNALS=true
# Let the brains (council, coach, survival council) choose each bunny's coins from lab evidence. The owner's coins,
# the style and the survival tier still limit it; a coin the coach adds trades at half size until kept.
BRAIN_WATCHLIST=true
# Free specialisation: the brains choose each bunny's method (any style, or any backtested lab skill, even one a bunny
# wrote). The bunny switches only when flat, and keeps a method at least SPECIALIZE_MIN_HOURS. Risk rules never change.
SPECIALIZATION=true
SPECIALIZE_MIN_HOURS=6
# Minutes between coach reviews while the engine runs (0 = off), and a hard daily cap on those LLM calls
COACH_INTERVAL_MIN=360
COACH_MAX_CALLS_DAY=12
# Each cycle every agent may design and walk-forward test a skill. 0 disables autonomous research.
SELF_RESEARCH_INTERVAL_MIN=360
SELF_RESEARCH_MAX_CALLS_DAY=12
# The autonomous lab refreshes public 1h history and rankings in a child process, so trading ticks never block.
# When scalp is enabled, its real 1m cost test (each coin with its coin-book rules) is refreshed daily, sooner when the lab
# brain queues new rules. 0 disables the respective loop.
AUTO_LAB_INTERVAL_HOURS=24
AUTO_LAB_START_DELAY_MIN=5
AUTO_SCALP_LAB_INTERVAL_HOURS=24

# ---- CoinMarketCap (optional): market-wide context -------------------------------
# Fear & Greed, BTC dominance and the market cap's 24h move for Jev (CMC_IN_JEV) and the brains, plus each coin's
# CMC rank, market cap and all-exchange volume in the watchlist evidence. Or paste the key in Admin -> API keys.
# 3 calls per refresh, plus 3 every CMC_SLOW_MIN for altcoin season, the Fear & Greed week and hot sectors. The defaults
# stay under the free Basic plan's 10,000 credits a month; CMC_MAX_CALLS_DAY is a hard cap.
COINMARKETCAP_API_KEY=
CMC_REFRESH_MIN=15
CMC_TOP=200
CMC_MAX_CALLS_DAY=330
CMC_SLOW_MIN=120
CMC_IN_JEV=true

# ---- Survival and rewards (docs/INTELLIGENCE.md) -----------------------------
# Bunnies know they can die at BEE_RETIRE_AT_PCT. In danger they trade smaller and their brains meet to save them.
SURVIVAL_MODE=true
SURVIVAL_DANGER_PCT=80
SURVIVAL_CRITICAL_PCT=60
SURVIVAL_MAX_CALLS_DAY=12
# Profitable bunnies earn points and levels: more skills, skill writing, extra brains, bigger (never leveraged) limits.
REWARDS=true
REWARD_MAX_LIMIT_BOOST=0.5
# Limit boosts with real money too. Off: in live mode rewards unlock skills and brains only.
REWARDS_IN_LIVE=false
# Multi-orders: level 0 starts with 3 positions and each level adds 3, all inside one shared leverage cap.
# Each position keeps its own code stop. Level 5 reaches the default ceiling of 18. 1 = off.
MAX_POSITIONS_PER_BEE=18
# Extra bunnies (bee4..bee9) are created on the admin panel with their own wallet and OKX sub-account (checked for
# permissions and balance before the bunny is created). Keys set here win over the panel's, e.g.:
# BEE4_OKX_DEMO_API_KEY= / BEE4_OKX_DEMO_API_SECRET= / BEE4_OKX_DEMO_API_PASSPHRASE=

# The Farmer (brains/farmer.ts): every FARMER_INTERVAL_MIN he looks at all the bunnies, says one line on the main page,
# and may rewrite a bunny's rules once a day. With MODE=live he only suggests unless FARMER_MODE=apply.
# FARMER=0 turns him off. FARMER_BRAIN picks his brain (claude, openai, kimi, zai or a custom id; default Claude, then ChatGPT).
# FARMER=1
# FARMER_MODE=
# FARMER_INTERVAL_MIN=120
# FARMER_BRAIN=
# His portrait is painted once with OPENAI_API_KEY (the image model, in the bunnies' style) and kept in the data volume;
# until then the page shows the drawn one. FARMER_PAINT=0 never paints.
# FARMER_PAINT=1

# The lab brain (docs/LAB_BRAIN.md): every LAB_BRAIN_INTERVAL_MIN it studies everything the brains know (the coin book,
# the scalp lab, the 1h ranking, every bunny's memory and record, approved notes, the crew, live P&L, why bunnies are not
# trading) and evolves each coin's scalp rules; one bunny per round proposes rules for its own coins. A rule trades only
# after the walk-forward lab passes it on real data. LAB_BRAIN picks the brain (default openai = GPT; 0 turns it off).
# LAB_BRAIN=openai
# The lab brain may use its own GPT model and effort, apart from the bunnies' (e.g. gpt-6-astra at max for the study):
# LAB_BRAIN_MODEL=gpt-6-astra
# LAB_BRAIN_EFFORT=max
# LAB_BRAIN_INTERVAL_MIN=360
# LAB_BRAIN_MAX_CALLS_DAY=8
# LAB_BRAIN_START_DELAY_MIN=10

# GhostProof (docs/GHOSTPROOF.md): every decision, order and fill becomes an AgentProof event with hashes only (never the
# snapshot, prompt, rules, sizes or keys), kept in a local outbox. GHOSTPROOF=1 records; GHOSTPROOF_TOKEN (a GhostID JWT
# with the agentproof scope) also sends to GHOSTPROOF_URL. GHOSTPROOF_ACTOR must be the token's ghostId.
# GHOSTPROOF=0
# GHOSTPROOF_URL=https://gateway.efps.live/api
# GHOSTPROOF_TOKEN=
# GHOSTPROOF_ACTOR=

# Visitors may ask a bunny for its view (the "Ask me" tab): its own brain answers, read-only, questions not stored.
# PUBLIC_CHAT=1
# PUBLIC_CHAT_PER_HOUR=5
# PUBLIC_CHAT_DAILY_LIMIT=300

# ---- The crew (brains/crew.ts): characters beside the Farmer, each with its own brain and data tools ----------------
# The Owl (coach) leaves each bunny a coaching note in its Warren inbox; the Rat (market analyst) reads CoinMarketCap and
# OKX and writes the market brief every bunny's brains read; the Pig (accountant) keeps the books and raises cost alerts.
# They advise only: never trade, move money or change a bunny's coins, style or size. OWL=0 / RAT=0 / PIG=0 sends one home.
# Brains: OWL_BRAIN, RAT_BRAIN, PIG_BRAIN (openai, claude, kimi, zai or a custom id; default ChatGPT). Intervals in minutes.
# OWL_INTERVAL_MIN=180
# RAT_INTERVAL_MIN=60
# PIG_INTERVAL_MIN=360
# Their portraits are painted once each with OPENAI_API_KEY; CREW_PAINT=0 never paints.

# ---- Backups ----
# How many nightly copies of each database the backup sidecar keeps in /data/backups (one per day).
BACKUP_KEEP_DAYS=3
