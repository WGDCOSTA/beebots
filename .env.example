# beebots settings. Most people need NONE of this: the Setup page asks for your keys when you first open the site.
# Copy to .env (next to docker-compose.yml) only if you want to change something. NEVER commit .env.

# ---- Mode -------------------------------------------------------------------
# dry  = PAPER TRADING (the default): real market prices, simulated money, no exchange account needed
# demo = OKX demo trading with per-bee DEMO keys, fake money on OKX's side
# live = REAL MONEY. Needs DRY_RUN=false, MODE=live, per-bee LIVE keys AND LIVE_ACK below. Not financial advice.
MODE=dry
# Safety latch. true (the default, also when unset) forces paper trading whatever MODE says.
DRY_RUN=true
# Only for MODE=live: must be exactly I-ACCEPT-REAL-MONEY-RISK. You can lose everything you put in.
LIVE_ACK=

# ---- Setup ------------------------------------------------------------------
# The Setup page stays open this many minutes after the engine starts. First come, first served: once saved it closes
# for good. If nobody finishes in time, restart the engine container to open it again.
SETUP_WINDOW_MIN=120
# The owner password is picked on Setup and stored as a hash. Set this only if your Setup file has none (an install
# from before it existed, or keys set only here). At least 8 characters. Gates Join/Leave the Hive on the dashboard.
OWNER_PASSWORD=

# ---- Jev (TypeSafe AI) ------------------------------------------------------
# Optional here (Setup asks for it). Key from https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=2000
# Hard daily Jev spend cap in USD. When hit, every bee holds and opens nothing until 00:00 UTC.
JEV_DAILY_USD_CAP=2
# How often each bee asks Jev (ms). 10000 = 18 decisions/min for three bees, about $0.90/day (docs/COSTS.md).
TICK_MS=10000
# Full market refresh (candles, indicators, funding, OI): every 60 s
DATA_REFRESH_MS=60000

# ---- OpenAI (optional) --------------------------------------------------------
# Setup asks for this too (required there). Used only on the Setup page: design each bee from a sentence, and paint it.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-nano
OPENAI_IMAGE_MODEL=gpt-image-2

# ---- OKX (EEA) --------------------------------------------------------------
# Market data comes from OKX's public EEA API. Demo/live keys must be EEA (my.okx.com) keys.
OKX_API_BASE=https://eea.okx.com

# Demo or live only: one OKX sub-account per bee. Keys: Read + Trade ONLY. Never Withdraw, never Transfer.
# Live keys should be IP-bound to your server. Demo keys come from OKX's demo-trading screen.
BEE1_OKX_DEMO_API_KEY=
BEE1_OKX_DEMO_API_SECRET=
BEE1_OKX_DEMO_API_PASSPHRASE=
BEE2_OKX_DEMO_API_KEY=
BEE2_OKX_DEMO_API_SECRET=
BEE2_OKX_DEMO_API_PASSPHRASE=
BEE3_OKX_DEMO_API_KEY=
BEE3_OKX_DEMO_API_SECRET=
BEE3_OKX_DEMO_API_PASSPHRASE=
BEE1_OKX_API_KEY=
BEE1_OKX_API_SECRET=
BEE1_OKX_API_PASSPHRASE=
BEE2_OKX_API_KEY=
BEE2_OKX_API_SECRET=
BEE2_OKX_API_PASSPHRASE=
BEE3_OKX_API_KEY=
BEE3_OKX_API_SECRET=
BEE3_OKX_API_PASSPHRASE=

# ---- Risk (every bee) ---------------------------------------------------------
BEE_START_EQUITY_USD=333
MAX_LEVERAGE=2
# Per-bee daily loss stop, % of that bee's equity at 00:00 UTC. Trip = flat until 00:00 UTC.
DAILY_LOSS_STOP_PCT=8
# If a bee's equity falls below this % of its start, it retires for good.
BEE_RETIRE_AT_PCT=40
# Hard ceiling on any bee's position size, whatever its balance says
MAX_NOTIONAL_USD_PER_BEE=700
# "Never flat for long" ceiling in minutes. Each style's own limit is min(its own, this).
MAX_FLAT_MINUTES=30
# First hours of live trading run at reduced size
LIVE_SIZE_MULTIPLIER=0.25
LIVE_RAMP_HOURS=2
MIN_24H_VOL_USD=1000000
# Master switch for the macro squad (extra bees on stocks, gold, oil; Admin -> Bees -> Market). Off: they watch and
# learn but never open. On: they open only in a trading hour the engine has verified (docs/MACRO_SQUAD.md).
# The crypto bees trade crypto only either way.
ALLOW_NON_CRYPTO=false
# Macro squad gates: stocks and gold trade far less than crypto on OKX
MACRO_MIN_24H_VOL_USD=200000
# The macro style's knobs (bees/macro.ts): trend pullbacks and range reversions, never forced in
MACRO_MAX_TRADES_PER_DAY=4
MACRO_FEE_BUDGET_USD_DAY=2
MACRO_SPREAD_GATE_BPS=15
MACRO_COOLDOWN_MINUTES=30
MACRO_STOP_ATR_MULT=2.5
# Leverage cap for macro positions (x equity, never above MAX_LEVERAGE), and the size factor under 2 h to the close
MACRO_MAX_LEVERAGE=1
MACRO_LATE_SESSION_SIZE=0.5
# Close macro positions before their session ends: all | weekend (closures of a day or more) | off, and how early
SESSION_FLATTEN=all
SESSION_FLATTEN_MIN=10
# No new macro position this close (minutes) to the end of a session
SESSION_NO_OPEN_MIN=30


# Dynamic profit-locking ratchet (bees/ratchet.ts), on top of each style's own stops; stops only ever tighten.
# RATCHET_LOCK: hard profit floor, gain%:keep (at +2.5% lock 50% of the best move, at +5% lock 65%).
# RATCHET_HUG: runner hug, gain%:ATR multiple (trail 1.2x ATR behind the peak from +2.5%, 0.8x from +5%, 0.6x from +8%).
# A gap or slippage can still fill past a stop: the floor is a stop level, not a guaranteed price.
RATCHET=true
RATCHET_LOCK=2.5:0.5,5:0.65
RATCHET_HUG=2.5:1.2,5:0.8,8:0.6
RATCHET_STYLES=bizzy,boozy,macro,skill

# ---- The scalper (optional, OFF): maker orders on 1-minute rules ----------------------
# Off by default. Even with SCALP=true a bee scalps only when its brains chose the "scalp" method AND the strategy
# lab's latest report on REAL 1-minute data found an edge after costs (pnpm lab fetch --bar 1m; pnpm lab scalp).
# Jev sets a mandate (a coin, a bias, a lifetime, a trade budget); code then trades inside it with maker limit orders
# and hard stops, and a circuit breaker pauses the bee after a run of losses. With real money the lab gate cannot be
# switched off. Paper fills for limit orders are optimistic: confirm on OKX demo before trusting any result.
SCALP=false
SCALP_REQUIRE_LAB=true
SCALP_LAB_MAX_AGE_DAYS=14
SCALP_COINS=BTC,ETH
SCALP_MAKER_FEE=0.0002
SCALP_TICK_MS=2000
SCALP_MAKER_WAIT_S=8
SCALP_EXIT_WAIT_S=3
SCALP_MANDATE_MIN=10
SCALP_MANDATE_MINUTES=30
SCALP_MANDATE_TRADES=20
SCALP_MAX_TRADES_PER_DAY=60
SCALP_FEE_BUDGET_USD_DAY=3
SCALP_SPREAD_GATE_BPS=1.5
SCALP_SIZE_FRAC=0.5
SCALP_MAX_LOSS_STREAK=4
SCALP_PAUSE_MIN=30
# ---- Per-style knobs ------------------------------------------------------------
# BIZZY_* = Breakout, BREEZY_* = Trend, BOOZY_* = Momentum. Every bee on that style uses them.
# See strategies/*.md. COOLDOWN_MINUTES: wait after an order. STOP_ATR_MULT: stop distance in ATR(14).
BREEZY_MAX_TRADES_PER_DAY=3
BREEZY_FEE_BUDGET_USD_DAY=1.00
BREEZY_MIN_OPEN_PROB=0.70
BREEZY_MIN_SIZE_USD=10
BREEZY_SPREAD_GATE_BPS=5
BREEZY_COOLDOWN_MINUTES=240
BREEZY_STOP_ATR_MULT=2
BREEZY_MAX_FLAT_MINUTES=0

BIZZY_MAX_TRADES_PER_DAY=1
BIZZY_FEE_BUDGET_USD_DAY=1.00
BIZZY_SIZE_FRACTION=0.4
BIZZY_UNIVERSE_SIZE=8
BIZZY_MAX_FLAT_MINUTES=20
BIZZY_SPREAD_GATE_BPS=5
BIZZY_COOLDOWN_MINUTES=5
BIZZY_STOP_ATR_MULT=1.5
BIZZY_TIME_STOP_MINUTES=240

BOOZY_MAX_TRADES_PER_DAY=3
BOOZY_FEE_BUDGET_USD_DAY=3.00
BOOZY_SPREAD_GATE_BPS=15
BOOZY_CANDIDATES=5
BOOZY_COOLDOWN_MINUTES=2
BOOZY_STOP_ATR_MULT=2
BOOZY_MAX_FLAT_MINUTES=0

# ---- Server -------------------------------------------------------------------
# A domain pointed at this server gets automatic HTTPS. Blank = plain HTTP on the server's IP.
PUBLIC_DOMAIN=
LOG_LEVEL=info
# Alerts (optional): a Telegram bot, ntfy.sh topic or any webhook URL. Cap trips, Jev outages, restarts.
ALERT_WEBHOOK_URL=
# The Hive: the public paper-trading leaderboard. Nothing is sent unless you join (on Setup or from the dashboard).
HIVE_URL=https://beebots.tech
# "Update available" on the dashboard when a newer GitHub Release is out. It never installs anything by itself.
UPDATE_CHECK=true
# Dashboard links: the "Hosted on" chip and the code link.
HOST_LINK=https://mrc.fm/beebots
REPO_LINK=https://github.com/imikerussell/beebots

# ---- LLM brains, strategy lab and hive mind (docs/INTELLIGENCE.md) ------------
# Each main bee thinks with its own LLM brain: it picks backtested skills, writes lessons and talks to the other bees
# through the hive mind (a knowledge graph). Brains never place orders: Jev still decides every tick and the risk layer
# still has the last word. A brain without a key falls back to a simple rules pick.
# ChatGPT uses OPENAI_API_KEY above.
OPENAI_BRAIN_MODEL=gpt-5.4
# Claude (Anthropic): https://console.anthropic.com
# Or leave it empty and sign in with an Anthropic Console account instead (docs/INTELLIGENCE.md):
#   docker compose exec engine ant --profile beebots auth login --no-browser
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium
# Kimi (Moonshot AI): https://platform.moonshot.ai  (MOONSHOT_API_KEY works too)
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.5
KIMI_BASE_URL=https://api.moonshot.ai/v1
# Alpaca (alpaca.markets) market data for the lab: US stocks, ETFs and crypto history. DATA ONLY: use paper keys.
# Also settable in Admin -> API keys. iex = free (one exchange); sip = every exchange, paid plan.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_FEED=iex
# Z.ai (GLM models): https://z.ai. International address below; China: https://open.bigmodel.cn/api/paas/v4
# Use the model id from your Z.ai console (glm-4.6 is the default here).
ZAI_API_KEY=
ZAI_MODEL=glm-4.6
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# Which brain each bee thinks with: openai | claude | kimi | zai | the id of a custom brain added in Admin -> API keys
BEE1_BRAIN=openai
BEE2_BRAIN=claude
BEE3_BRAIN=kimi
# Where the lab keeps history, rankings, the playbook and the hive-mind graph
LAB_DIR=./data/lab
GRAPH_PATH=./data/lab/hive-mind.sqlite
# Folders of importable JSON skills (comma separated)
SKILLS_DIRS=./skills
# Show Jev each bee's lab vote (its playbook skills on 1h bars) as a tiebreaker. Off by default.
LAB_SIGNALS=false
# Let the brains (council, coach, survival council) choose each bee's coins from lab evidence. The owner's coins,
# the style and the survival tier still limit it; a coin the coach adds trades at half size until kept.
BRAIN_WATCHLIST=true
# Free specialisation: the brains choose each bee's method (any style, or any backtested lab skill, even one a bee
# wrote). The bee switches only when flat, and keeps a method at least SPECIALIZE_MIN_HOURS. Risk rules never change.
SPECIALIZATION=true
SPECIALIZE_MIN_HOURS=6
# Minutes between coach reviews while the engine runs (0 = off), and a hard daily cap on those LLM calls
COACH_INTERVAL_MIN=0
COACH_MAX_CALLS_DAY=12

# ---- CoinMarketCap (optional): market-wide context -------------------------------
# Fear & Greed, BTC dominance and the market cap's 24h move for Jev (CMC_IN_JEV) and the brains, plus each coin's
# CMC rank, market cap and all-exchange volume in the watchlist evidence. Or paste the key in Admin -> API keys.
# 3 calls per refresh; the free Basic plan has 10,000 credits a month, and CMC_MAX_CALLS_DAY is a hard cap.
COINMARKETCAP_API_KEY=
CMC_REFRESH_MIN=15
CMC_TOP=200
CMC_MAX_CALLS_DAY=300
CMC_IN_JEV=true

# ---- Survival and rewards (docs/INTELLIGENCE.md) -----------------------------
# Bees know they can die at BEE_RETIRE_AT_PCT. In danger they trade smaller and their brains meet to save them.
SURVIVAL_MODE=true
SURVIVAL_DANGER_PCT=80
SURVIVAL_CRITICAL_PCT=60
SURVIVAL_MAX_CALLS_DAY=12
# Profitable bees earn points and levels: more skills, skill writing, extra brains, bigger (never leveraged) limits.
REWARDS=true
REWARD_MAX_LIMIT_BOOST=0.5
# Limit boosts with real money too. Off: in live mode rewards unlock skills and brains only.
REWARDS_IN_LIVE=false
# Multi-orders: top performers hold several positions on different coins (level 3: 2, level 5: 3), all inside one
# leverage cap, each with its own code stop. Follows REWARDS_IN_LIVE with real money. 1 = off.
MAX_POSITIONS_PER_BEE=3
# Extra bees (bee4..bee9) are created on the admin panel with their own wallet and OKX sub-account (checked for
# permissions and balance before the bee is created). Keys set here win over the panel's, e.g.:
# BEE4_OKX_DEMO_API_KEY= / BEE4_OKX_DEMO_API_SECRET= / BEE4_OKX_DEMO_API_PASSPHRASE=
