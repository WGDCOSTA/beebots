# beebots: SITE_ADDRESS is PUBLIC_DOMAIN when set (Caddy gets the HTTPS certificate itself), otherwise :80 (plain HTTP on any address).
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Read-only engine endpoints. Only GET is proxied; the engine refuses everything else too.
	@api {
		method GET
		path /events /snapshot /history /equity /visit /health /profile /bee-image/* /setup/status /hive/status /lab/ranking /lab/playbook /hive-mind /hive-mind/* /bunny/* /chat
	}
	handle @api {
		reverse_proxy engine:8080 {
			# Server-sent events: never buffer.
			flush_interval -1
		}
	}

	# First-run Setup writes. The engine only accepts them before Setup is done, within the setup window.
	@setup {
		method POST
		path /setup/*
	}
	handle @setup {
		request_body {
			max_size 64KB
		}
		reverse_proxy engine:8080 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# A visitor's question to a bunny (publicChat.ts). Read-only on the engine's side; it limits questions per address and per day.
	@chat {
		method POST
		path /chat/send
	}
	handle @chat {
		request_body {
			max_size 8KB
		}
		reverse_proxy engine:8080
	}

	# Joining or leaving the Warren from the dashboard. The engine needs the owner password for both.
	# (/hive/report is the live leaderboard's own route; the engine does not serve it.)
	@hive {
		method POST
		path /hive/join /hive/leave
	}
	handle @hive {
		request_body {
			max_size 16KB
		}
		reverse_proxy engine:8080
	}

	# The admin panel (#/admin on the dashboard). Every call carries the owner password; the engine checks it.
	@admin {
		method POST
		path /admin/*
	}
	handle @admin {
		request_body {
			max_size 64KB
		}
		reverse_proxy engine:8080
	}

	# The Arena (members' accounts and agents): a separate service, only up when the "arena" compose profile is on.
	# It does its own sign-in, rate limits and checks; Caddy passes the client address in X-Forwarded-For.
	handle /arena/* {
		request_body {
			max_size 256KB
		}
		reverse_proxy arena:8090
	}

	# Static dashboard, built into the image. Hashed assets are immutable; index.html revalidates.
	handle {
		root * /srv/dashboard
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; media-src 'self' data: blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
	}
}
